<!DOCTYPE html>
<html>
<head>
  <title>Sleepy Bot Dashboard</title>
  <style>
    body{
      background:#111827;
      color:white;
      font-family:Arial;
      text-align:center;
      padding-top:50px;
    }

    .card{
      background:#1f2937;
      width:400px;
      margin:auto;
      padding:30px;
      border-radius:20px;
      box-shadow:0 0 20px rgba(0,0,0,0.5);
    }

    .btn{
      display:block;
      background:#5865F2;
      color:white;
      text-decoration:none;
      padding:15px;
      margin:15px 0;
      border-radius:10px;
      transition:0.2s;
    }

    .btn:hover{
      background:#4752c4;
    }

    img{
      border-radius:50%;
      margin-bottom:15px;
    }
  </style>
</head>
<body>

<div class="card">
  <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" width="100">

  <h1>Welcome <%= user.username %></h1>

  <div style="margin-top:20px;">
  <p>Servers: <%= stats.guilds %></p>
  <p>Custom Commands: <%= stats.commands %></p>
  <p>Total Warns: <%= stats.warns %></p>
</div>

  <a class="btn" href="/commands">⚡ Manage Commands</a>
  <a class="btn" href="/warns">🛡 Manage Warns</a>
  <a class="btn" href="/logout">🚪 Logout</a>
  <a class="btn" href="/moderation">🛡 Moderation</a>
  <a class="btn" href="/settings">⚙ Settings</a>
</div>

</body>
</html>